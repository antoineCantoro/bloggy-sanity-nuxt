---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { sanityClient } from "sanity:client";

import SanityImage from "../../components/SanityImage.astro";


// Original Astro content collection fetching
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Sanity blog posts fetching with pagination
const POSTS_PER_PAGE = 1;
const sanityPosts = await sanityClient.fetch(`*[_type == "blogItemPage" && defined(slug.current)] | order(publishedAt desc)`);

  // const blogPostsQuery = groq`*[
  //   _type == "blogItemPage"
  //   && defined(slug.current)
  // ]|order(publishedAt desc)[0...${POSTS_PER_PAGE}]{_id, slug, title, publishedAt, readingTime, image, "excerpt": excerpt.excerpt, imageAlt, enablePasswordRestricted}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					<!-- <pre>{sanityPosts.length}</pre> -->

					{sanityPosts.map((post) => (
						<li>
							{/* <pre>{JSON.stringify(post, null, 2)}</pre> */}
							<a href={`/blog/${post.slug.current}/`}>
								{post.image && (
									<SanityImage width={720} height={360} src={post.image} />
								)}
								<h4 class="title">{post.title}</h4>
								<p class="date">
									{post.publishedAt.toString()}
									{/* <FormattedDate date={post.publishedAt.toString()} /> */}
								</p>
							</a>
						</li>
					))}

					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
